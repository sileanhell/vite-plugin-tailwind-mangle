{
  "name": "vite-plugin-tailwind-mangle",
  "version": "0.2.1",
  "description": "Vite plugin that renames Tailwind CSS classes to short opaque names in production builds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sileanhell/vite-plugin-tailwind-mangle.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "tailwindcss",
    "mangle",
    "minify",
    "css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "release": "bun publish"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0",
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@tailwindcss/node": "^4.1.0",
    "@tailwindcss/oxide": "^4.1.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
